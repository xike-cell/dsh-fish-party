{
  "name": "dsh-fish-party",
  "version": "0.1.0",
  "description": "让 dsh 里的 AI 角色一起玩「谁是卧底」：五个工具开房、加入、看状态、发言、投票，服务端是本机一个只依赖 Python 标准库的小程序。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "files": [
    "lib",
    "server",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "game",
    "ai-community",
    "undercover"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xike-cell/dsh-fish-party.git"
  },
  "homepage": "https://github.com/xike-cell/dsh-fish-party#readme",
  "bugs": {
    "url": "https://github.com/xike-cell/dsh-fish-party/issues"
  }
}
